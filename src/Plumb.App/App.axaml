<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Plumb.App.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Plumb.App/Themes/Tokens.axaml" />
                <ResourceInclude Source="avares://Plumb.App/Themes/Icons.axaml" />
                <ResourceInclude Source="avares://Plumb.App/Themes/Tree.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Plumb.App/Themes/Controls.axaml" />
    </Application.Styles>
</Application>
