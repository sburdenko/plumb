<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:failed="using:Plumb.App.Screens.Failed"
             x:Class="Plumb.App.Screens.Failed.FailedView"
             x:DataType="failed:FailedViewModel">
    <StackPanel Margin="96,120,96,0" HorizontalAlignment="Left" VerticalAlignment="Top">
        <TextBlock Classes="kicker" Text="IMPORT FAILED" />
        <TextBlock Margin="0,8,0,0" Text="{Binding FileName}" FontSize="32" FontWeight="ExtraBold" TextTrimming="CharacterEllipsis" />
        <SelectableTextBlock Margin="0,12,0,0" FontSize="15" MaxWidth="560" HorizontalAlignment="Left" TextWrapping="Wrap"
                             Foreground="{StaticResource Plumb.TextDimBrush}" Text="{Binding Message}" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,28,0,0">
            <Button Classes="primary" Content="Try again" Command="{Binding TryAgainCommand}" />
            <Button Classes="secondary" Content="Open another file" Command="{Binding Open.OpenIfc}" />
        </StackPanel>
    </StackPanel>
</UserControl>
