<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:model="using:Plumb.App.Screens.Model"
             xmlns:properties="using:Plumb.App.Screens.Model.Properties"
             xmlns:tree="using:Plumb.App.Screens.Model.Tree"
             xmlns:viewport="using:Plumb.App.Screens.Model.Viewport"
             xmlns:controls="using:Plumb.App.Controls"
             x:Class="Plumb.App.Screens.Model.LoadedView"
             x:DataType="model:LoadedViewModel">
    <UserControl.Styles>
        <!-- Tree row text -->
        <Style Selector="TextBlock.title">
            <Setter Property="Foreground" Value="{StaticResource Plumb.TextTreeBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.title.strong">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.title.active">
            <Setter Property="FontWeight" Value="ExtraBold" />
        </Style>
        <Style Selector="TextBlock.meta">
            <Setter Property="Foreground" Value="{StaticResource Plumb.TextMutedBrush}" />
        </Style>
        <!-- The row's text comes from a data template, not the item's template, so the row carries the selection itself. -->
        <Style Selector="Grid.row.selected TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Plumb.TextBrush}" />
        </Style>
        <Style Selector="Grid.row.selected TextBlock.title">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="52,300,*,380">
        <!-- Icon rail -->
        <Border Background="{StaticResource Plumb.PanelBrush}" BorderBrush="{StaticResource Plumb.RuleBrush}" BorderThickness="0,0,2,0">
            <StackPanel Margin="0,8,0,0" Spacing="4">
                <Grid Height="44" ToolTip.Tip="Model">
                    <Rectangle Width="3" HorizontalAlignment="Left" Fill="{StaticResource Plumb.AccentBrush}" />
                    <controls:LucideIcon Data="{StaticResource Icon.ListTree}" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Spatial tree -->
        <Border Grid.Column="1" Background="{StaticResource Plumb.InkBrush}" BorderBrush="{StaticResource Plumb.RuleBrush}" BorderThickness="0,0,2,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="14,14,14,10" Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="caps" Text="SPATIAL STRUCTURE" />
                        <TextBlock Grid.Column="1" Classes="caps muted numbers" Text="{Binding ElementCount}" />
                    </Grid>
                    <TextBox Name="FilterBox" Classes="filter" PlaceholderText="Filter elements" Text="{Binding Filter}">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Escape" Command="{Binding ClearFilterCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                </StackPanel>
                <TreeView ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ItemsSource="{Binding Nodes}"
                          SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                          ItemContainerTheme="{StaticResource Plumb.TreeItem}">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate DataType="tree:TreeNodeViewModel" ItemsSource="{Binding Children}">
                            <Grid Classes="row" Classes.selected="{Binding $parent[TreeViewItem].IsSelected}"
                                  ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding Label}" Background="Transparent">
                                <TextBlock Classes="title" Classes.strong="{Binding IsStrong}" Classes.active="{Binding IsActiveStorey}">
                                    <Run Text="{Binding Title}" />
                                    <Run Text="{Binding SubtitleSuffix}" FontWeight="Normal" Foreground="{StaticResource Plumb.TextMutedBrush}" />
                                </TextBlock>
                                <TextBlock Grid.Column="1" Classes="meta numbers" Text="{Binding Meta}" Margin="6,0,12,0" />
                            </Grid>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>
        </Border>

        <!-- Viewport -->
        <Grid Grid.Column="2" RowDefinitions="44,*" Background="{StaticResource Plumb.InkBrush}">
            <Border BorderBrush="{StaticResource Plumb.RuleBrush}" BorderThickness="0,0,0,1" Padding="14,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Classes="caps" Text="GEOMETRY" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="muted numbers" FontSize="12" VerticalAlignment="Center" Text="{Binding Viewport.GeometryInfo}" />
                </Grid>
            </Border>

            <Panel Grid.Row="1" Background="{StaticResource Plumb.GridBrush}">
                <StackPanel Margin="48,120,48,0" HorizontalAlignment="Left" VerticalAlignment="Top" Spacing="16">
                    <viewport:ViewportView DataContext="{Binding Viewport}" />
                    <TextBlock Text="{Binding ActionError}" IsVisible="{Binding ActionError, Converter={x:Static ObjectConverters.IsNotNull}}"
                               Foreground="{StaticResource Plumb.AccentOnDarkBrush}" TextWrapping="Wrap" MaxWidth="460" HorizontalAlignment="Left" />
                </StackPanel>

                <!-- Selection badge -->
                <Grid ColumnDefinitions="3,Auto" Margin="14,0,0,12" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                      IsVisible="{Binding HasSelection}">
                    <Rectangle Fill="{StaticResource Plumb.AccentBrush}" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2">
                        <TextBlock Text="SELECTED" FontSize="10" LetterSpacing="1.2" FontWeight="SemiBold" Classes="muted" />
                        <TextBlock Text="{Binding SelectedName}" FontSize="14" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Panel>
        </Grid>

        <!-- Properties -->
        <Border Grid.Column="3" Background="{StaticResource Plumb.PanelBrush}" BorderBrush="{StaticResource Plumb.RuleBrush}" BorderThickness="2,0,0,0">
            <Panel>
                <StackPanel Margin="16" Spacing="6" IsVisible="{Binding SelectedElement, Converter={x:Static ObjectConverters.IsNull}}">
                    <TextBlock Text="No element selected" FontSize="16" FontWeight="ExtraBold" />
                    <TextBlock Classes="muted" Text="Select an element in the tree or the 3D view." TextWrapping="Wrap" />
                </StackPanel>
                <ScrollViewer DataContext="{Binding SelectedElement}" IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <properties:ElementDetailsView />
                </ScrollViewer>
            </Panel>
        </Border>
    </Grid>
</UserControl>
