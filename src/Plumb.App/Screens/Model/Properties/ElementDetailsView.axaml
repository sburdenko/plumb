<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:properties="using:Plumb.App.Screens.Model.Properties"
             x:Class="Plumb.App.Screens.Model.Properties.ElementDetailsView"
             x:DataType="properties:ElementDetailsViewModel">
    <StackPanel>
        <Border Padding="16" BorderBrush="{StaticResource Plumb.RuleBrush}" BorderThickness="0,0,0,2">
            <StackPanel Spacing="6">
                <TextBlock Classes="kicker" Text="{Binding Kicker}" />
                <SelectableTextBlock Text="{Binding Title}" FontSize="20" FontWeight="ExtraBold" LineHeight="24" TextWrapping="Wrap" />
                <SelectableTextBlock Classes="muted numbers" FontSize="12">
                    <Run Text="{Binding GlobalId}" />
                    <Run Text="{Binding TagSuffix}" />
                </SelectableTextBlock>
            </StackPanel>
        </Border>
        <TextBlock Margin="16" Classes="muted" Text="This element has no properties." IsVisible="{Binding !HasProperties}" />
        <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="properties:PropertyGroupViewModel">
                    <Border Padding="16,12" BorderBrush="{StaticResource Plumb.RuleBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Name}" FontWeight="ExtraBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Margin="10,0,0,0" Classes="muted" FontSize="11" LetterSpacing="0.66"
                                           Text="{Binding Source}" VerticalAlignment="Center" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="properties:PropertyRowViewModel">
                                        <Grid ColumnDefinitions="*,10,*" Margin="0,4">
                                            <TextBlock Classes="muted" Text="{Binding Key}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Key}" />
                                            <TextBlock Grid.Column="2" Classes="numbers" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FullValue}">
                                                <Run Text="{Binding Value}" FontWeight="SemiBold" />
                                                <Run Text="{Binding UnitSuffix}" Foreground="{StaticResource Plumb.TextMutedBrush}" />
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
