<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:recent="using:Plumb.App.Screens.Start.Recent"
             xmlns:controls="using:Plumb.App.Controls"
             x:Class="Plumb.App.Screens.Start.Recent.RecentModelsView"
             x:DataType="recent:RecentModelsViewModel">
    <UserControl.DataTemplates>
        <DataTemplate DataType="recent:RecentModelItemViewModel">
            <Border Classes="recent" Classes.missing="{Binding IsMissing}" Classes.pinned="{Binding IsPinned}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Open" Command="{Binding OpenCommand}" />
                        <MenuItem Header="{Binding RevealLabel}" Command="{Binding RevealCommand}" />
                        <MenuItem Header="{Binding PinTip}" Command="{Binding TogglePinCommand}" />
                        <Separator />
                        <MenuItem Header="Remove from list" Command="{Binding RemoveCommand}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <Button Classes="recent-open" Command="{Binding OpenCommand}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock Classes="recent-title" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="muted" FontSize="12" Text="{Binding Location}" TextTrimming="PrefixCharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="5" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <TextBlock Classes="muted numbers" FontSize="12" Text="{Binding Elements}" VerticalAlignment="Center" />
                                    <Border BorderBrush="{StaticResource Plumb.BorderBrush}" BorderThickness="1" Padding="6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Schema}" FontSize="11" Foreground="{StaticResource Plumb.TextSoftBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock HorizontalAlignment="Right" FontSize="12" Classes="dim" Text="{Binding LastOpened}" IsVisible="{Binding !IsMissing}" />
                                <TextBlock HorizontalAlignment="Right" FontSize="12" Text="Not found" IsVisible="{Binding IsMissing}"
                                           Foreground="{StaticResource Plumb.AccentOnDarkBrush}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Grid.Column="1" Classes="row-action pin" Command="{Binding TogglePinCommand}" ToolTip.Tip="{Binding PinTip}"
                            AutomationProperties.Name="{Binding PinTip}">
                        <controls:LucideIcon Data="{StaticResource Icon.Pin}" Size="16" />
                    </Button>
                    <Button Grid.Column="2" Classes="row-action" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove from list"
                            AutomationProperties.Name="Remove from list">
                        <controls:LucideIcon Data="{StaticResource Icon.X}" Size="16" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <StackPanel>
        <TextBlock Classes="caps muted" Text="RECENT MODELS" Margin="0,0,0,12" />

        <TextBlock Classes="muted" FontSize="14" TextWrapping="Wrap" IsVisible="{Binding IsEmpty}"
                   Text="Models you open appear here, newest first. Pin the ones you come back to." />

        <TextBox Classes="filter" Margin="0,0,0,12" PlaceholderText="Filter recent models" Text="{Binding Filter}" IsVisible="{Binding CanFilter}">
            <TextBox.KeyBindings>
                <KeyBinding Gesture="Escape" Command="{Binding ClearFilterCommand}" />
            </TextBox.KeyBindings>
        </TextBox>

        <TextBlock Classes="caps dim" Text="PINNED" Margin="12,4,0,6" IsVisible="{Binding HasPinned}" />
        <ItemsControl ItemsSource="{Binding Pinned}" />

        <TextBlock Classes="caps dim" Text="RECENT" Margin="12,20,0,6">
            <TextBlock.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="HasPinned" />
                    <Binding Path="HasRecent" />
                </MultiBinding>
            </TextBlock.IsVisible>
        </TextBlock>
        <ItemsControl ItemsSource="{Binding Recent}" />

        <Button Classes="flat" Margin="12,12,0,0" Content="{Binding ShowAllText}" Command="{Binding ShowAllCommand}" IsVisible="{Binding HasHidden}" />
        <TextBlock Classes="muted" Margin="12,8,0,0" Text="No recent model matches the filter." IsVisible="{Binding HasNoMatches}" />
        <TextBlock Margin="12,12,0,0" Text="{Binding ActionError}" IsVisible="{Binding ActionError, Converter={x:Static ObjectConverters.IsNotNull}}"
                   TextWrapping="Wrap" Foreground="{StaticResource Plumb.AccentOnDarkBrush}" />
    </StackPanel>
</UserControl>
