<Project>
  <!--
    Copies the Unity viewer from viewer-build/ (made by tools/build-viewer.sh) next to the app.
    A target rather than CopyToOutputDirectory items, so projects referencing the app (the tests)
    do not get their own 68 MB copy. Unity's *DoNotShip* debug-symbol folders are left behind.
  -->
  <PropertyGroup>
    <ViewerBuildSource>$(MSBuildThisFileDirectory)../viewer-build/</ViewerBuildSource>
  </PropertyGroup>

  <Target Name="CollectViewerBuild">
    <ItemGroup>
      <ViewerBuildFile Include="$(ViewerBuildSource)**"
                       Exclude="$(ViewerBuildSource)*DoNotShip*/**;$(ViewerBuildSource)*DontShipItWithYourGame*/**" />
    </ItemGroup>
  </Target>

  <Target Name="CopyViewerBuild" AfterTargets="Build" DependsOnTargets="CollectViewerBuild" Condition="Exists('$(ViewerBuildSource)')">
    <Copy SourceFiles="@(ViewerBuildFile)"
          DestinationFiles="@(ViewerBuildFile->'$(OutDir)viewer-build/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishViewerBuild" AfterTargets="Publish" DependsOnTargets="CollectViewerBuild" Condition="Exists('$(ViewerBuildSource)')">
    <Copy SourceFiles="@(ViewerBuildFile)"
          DestinationFiles="@(ViewerBuildFile->'$(PublishDir)viewer-build/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
